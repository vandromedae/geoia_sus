# === Banco de Dados ===
# AVISO: Troque esta senha antes de qualquer uso em produção
# Usada pelo docker-compose (interpolação) e pela API em execução local.
POSTGRES_PASSWORD=geoai_secret
# Local: localhost:5432 (porta publicada do container). O docker-compose
# sobrescreve esta URL para o host interno "db" dentro dos containers.
DATABASE_URL=postgresql://geoai:geoai_secret@localhost:5432/geoia_sus

# === Provedor LLM (groq | ollama | fake) ===
LLM_PROVIDER=groq

# === Groq (nuvem, requer chave) ===
# Obtenha em: https://console.groq.com/keys
GROQ_API_KEY=sua_chave_aqui
# Modelos do Groq mudam com frequência; confira em https://console.groq.com/models
GROQ_MODEL=qwen/qwen3.8-27b

# === Ollama (local, offline) ===
# Descomente e edite para usar Ollama:
# LLM_PROVIDER=ollama
# OLLAMA_URL=http://ollama:11434
# OLLAMA_MODEL=qwen3:8b

# === CORS (frontend acessa a API) ===
CORS_ORIGINS=["http://localhost:8501","http://localhost:3000"]
