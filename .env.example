# === Banco de Dados ===
# AVISO: Troque esta senha antes de qualquer uso em produção
DATABASE_URL=postgresql://geoai:geoai_secret@db:5432/geoia_sus

# === Provedor LLM (groq | ollama) ===
LLM_PROVIDER=groq

# === Groq (nuvem, requer chave) ===
# Obtenha em: https://console.groq.com/keys
GROQ_API_KEY=sua_chave_aqui
GROQ_MODEL=qwen-qwq-32b

# === Ollama (local, offline) ===
# Descomente e edite para usar Ollama:
# LLM_PROVIDER=ollama
# OLLAMA_URL=http://ollama:11434
# OLLAMA_MODEL=qwen3:8b

# === CORS (frontend acessa a API) ===
CORS_ORIGINS=["http://localhost:8501","http://localhost:3000"]
